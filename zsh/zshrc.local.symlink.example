# Github PAT. Eager (always in ENV, bundler and gh read it), but resolved
# through op_cached_read (1password/op-cache.zsh) so a new terminal window does
# not raise a 1Password authorization prompt. `op_cache_clear github-pat`
# forces a refresh.
export GITHUB_TOKEN="$(op_cached_read github-pat 'op://Private/GitHub/Section/PAT' --account YOUR_ACCOUNT.1password.com)"
