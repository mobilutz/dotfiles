<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.copy-screenshot-to-clipboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>DOTFILES_PATH/screenshots/copy-screenshot-to-clipboard.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>SCREENSHOT_DIR</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>1</integer>
</dict>
</plist>
