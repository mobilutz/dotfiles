#!/bin/sh
#
# Delete all local branches whose upstream is gone. Worktrees checking out such
# a branch are removed first, otherwise git refuses to delete the branch.
# Worktrees with uncommitted changes are kept and reported.
#
#   https://stackoverflow.com/a/33548037/575547

set -e

git pull
git fetch -p

worktree_for_branch() {
    git worktree list --porcelain | awk -v want="refs/heads/$1" '
        /^worktree / { path = substr($0, 10) }
        /^branch /   { if ($2 == want) { print path; exit } }
    '
}

gone_branches() {
    git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads |
        awk '$2 == "[gone]" { print $1 }'
}

for branch in $(gone_branches); do
    worktree=$(worktree_for_branch "$branch")

    if [ -n "$worktree" ]; then
        if ! git worktree remove "$worktree"; then
            echo "skipping $branch: worktree $worktree is not clean" >&2
            continue
        fi
        echo "Removed worktree $worktree"
    fi

    git branch -D "$branch"
done
