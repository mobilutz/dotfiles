# Copy to npm/auth.local.zsh and fill in your own 1Password references.
# Gitignored (*.local.*).
#
# ~/.npmrc interpolates these ${VARs} at read time, so they must be exported
# before npm/yarn runs. Interactive shells only; never block startup.
# op_cached_read (1password/op-cache.zsh) caches the resolved secrets on disk so
# a new terminal window does not raise a 1Password authorization prompt.
if [[ -o interactive ]] && (( $+functions[op_cached_read] )); then
  : ${NPM_GITHUB_TOKEN:=$(op_cached_read npm-github-pat "op://<VAULT>/<ITEM>/<FIELD>")}
  : ${NPM_TOKEN:=$(op_cached_read npmjs-pat "op://<VAULT>/<ITEM>/<FIELD>")}
  export NPM_GITHUB_TOKEN NPM_TOKEN
fi
