#!/usr/bin/env bash
#
# bootstrap installs things.
#
# Unattended run (e.g. a Raspberry Pi provisioned over ssh):
#
#   DOTFILES_NONINTERACTIVE=1 \
#   GIT_AUTHORNAME="Your Name" \
#   GIT_AUTHOREMAIL="you@example.com" \
#   script/bootstrap
#
# That answers both questions up front and overwrites conflicting dotfiles
# instead of asking per file. GIT_SIGNINGKEY is optional; without it the
# generated ~/.gitconfig.local has no signing key and leaves signing off.

# Synology Drive
# - Alfred Settings Copy -> Through Synology Drive
# - Rectangle Settings Copy
# - iTerm2 Settings Copy
# - SSH Config

# TODO
# - VS Code Settings Copy
# - Transfer CleanMyMac License
# - CleanMyMac Settings Copy
# - Email Git Signing

# davinci resolve -> Not possible

red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
blue='\033[0;34m'
magenta='\033[0;35m'
cyan='\033[0;36m'
# Clear the color after that
clear='\033[0m'


cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

# Which OS are we on. Topic files can target a single platform by carrying an
# OS segment in their name: foo.darwin.zsh, install.linux.sh,
# gitconfig.linux.symlink. See README.md under "components".
case "$(uname -s)" in
  Darwin) DOTFILES_OS=darwin ;;
  Linux)  DOTFILES_OS=linux ;;
  *)      DOTFILES_OS="$(uname -s | tr '[:upper:]' '[:lower:]')" ;;
esac
export DOTFILES_OS

echo ''

info () {
  printf "\r  [ ${blue}..${clear} ] ${1}\n"
}

user () {
  printf "\r  [ ${yellow}??${clear} ] ${1}\n"
}

success () {
  printf "\r\033[2K  [ ${green}OK${clear} ] ${1}\n"
}

fail () {
  printf "\r\033[2K  [${red}FAIL${clear}] ${1}\n"
  echo ''
  exit
}

warn () {
  printf "\r  [${magenta}WARN${clear}] ${1}\n"
}

# Everything that names a local binary or app lives in ~/.gitconfig.local, not
# in the public git/gitconfig.symlink, so a machine without VS Code, MacGPG2 or
# a signing key still gets a working git.
setup_gitconfig () {
  if [ -f git/gitconfig.local.symlink ]
  then
    return
  fi

  info 'setup gitconfig'

  local git_credential='cache --timeout=3600'
  local git_editor='vim'
  local git_gpgsign='false'

  if [ "$DOTFILES_OS" = "darwin" ]
  then
    git_credential='osxkeychain'
    git_editor='code --wait'
    git_gpgsign='true'
  fi

  local git_authorname="$GIT_AUTHORNAME"
  local git_authoremail="$GIT_AUTHOREMAIL"
  local git_signingkey="$GIT_SIGNINGKEY"

  if [ -z "$git_authorname" ] || [ -z "$git_authoremail" ]
  then
    if [ "$DOTFILES_NONINTERACTIVE" = "1" ]
    then
      fail 'set GIT_AUTHORNAME and GIT_AUTHOREMAIL for a non-interactive run'
    fi

    if [ -z "$git_authorname" ]
    then
      user ' - What is your git author name?'
      read -e git_authorname
    fi

    if [ -z "$git_authoremail" ]
    then
      user ' - What is your git author email?'
      read -e git_authoremail
    fi
  fi

  sed -e "s/AUTHORNAME/$git_authorname/g" \
      -e "s/AUTHOREMAIL/$git_authoremail/g" \
      -e "s/GPG_SIGNINGKEY/$git_signingkey/g" \
      -e "s/GIT_COMMIT_GPGSIGN/$git_gpgsign/g" \
      -e "s|GIT_CREDENTIAL_HELPER|$git_credential|g" \
      -e "s|GIT_EDITOR|$git_editor|g" \
      git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

  # An empty signingkey would make `git commit -S` fail with a confusing error
  if [ -z "$git_signingkey" ]
  then
    sed -e '/signingkey =[[:space:]]*$/d' git/gitconfig.local.symlink > git/gitconfig.local.symlink.tmp
    mv git/gitconfig.local.symlink.tmp git/gitconfig.local.symlink
  fi

  success 'gitconfig'
}


link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  # Nobody is there to answer the per-file prompt on a fleet of Pis
  if [ "$DOTFILES_NONINTERACTIVE" = "1" ]
  then
    overwrite_all=true
  fi

  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*.git*')
  do
    local name="$(basename "${src%.symlink}")"

    # foo.darwin.symlink and foo.linux.symlink both land on ~/.foo, but only
    # on the OS they name.
    case "$name" in
      *.darwin) [ "$DOTFILES_OS" = "darwin" ] || continue; name="${name%.darwin}" ;;
      *.linux)  [ "$DOTFILES_OS" = "linux" ]  || continue; name="${name%.linux}" ;;
    esac

    link_file "$src" "$HOME/.$name"
  done
}

setup_vim () {
  info 'setup vim config'

  mkdir -p ~/.vim/backups
  mkdir -p ~/.vim/swaps
  mkdir -p ~/.vim/undo
  mkdir -p ~/.vim/pack/tpope/start

  # No `cd`: it used to leave the rest of the script in ~/.vim
  if [ ! -d ~/.vim/pack/tpope/start/sensible ]
  then
    git clone https://tpope.io/vim/sensible.git ~/.vim/pack/tpope/start/sensible
  fi
}

# The oh-my-zsh installer refuses to run without zsh, and on a fresh Debian box
# nothing else puts it there. On macOS bin/dot does this later, via Homebrew.
install_packages () {
  if [ "$DOTFILES_OS" != "linux" ]
  then
    return
  fi

  info 'installing packages'

  if [ "$(id -u)" = "0" ]
  then
    apt-get update -qq
  else
    sudo apt-get update -qq
  fi

  "$DOTFILES_ROOT/linux/install.linux.sh"
}

# None of this repo does anything under bash, and nothing on a Pi switches the
# login shell for us. On macOS the shell is already zsh, so this returns early.
setup_login_shell () {
  local zsh_path
  zsh_path="$(command -v zsh || true)"

  [ -n "$zsh_path" ] || return 0
  case "$SHELL" in *zsh) return 0 ;; esac

  local me
  me="$(id -un)"

  info "setting login shell to $zsh_path"

  if ! grep -qx "$zsh_path" /etc/shells 2>/dev/null
  then
    if [ "$(id -u)" = "0" ]
    then
      echo "$zsh_path" >> /etc/shells
    else
      echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
  fi

  if chsh -s "$zsh_path" "$me" 2>/dev/null || sudo chsh -s "$zsh_path" "$me" 2>/dev/null
  then
    success "login shell is now $zsh_path"
  else
    warn "could not change the login shell, run: chsh -s $zsh_path"
  fi
}

setup_oh_my_zsh () {
  info 'setup oh-my-zsh'

  # zshrc.symlink is useless without the framework, and on a fresh Pi nothing
  # else installs it. --keep-zshrc so the installer leaves our ~/.zshrc alone.
  if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]
  then
    RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
  fi

  local custom_dir=${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}
  mkdir -p "$custom_dir/themes"
  mkdir -p "$custom_dir/plugins"

  [ -d "$custom_dir/themes/powerlevel10k" ] || git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$custom_dir/themes/powerlevel10k"
  [ -d "$custom_dir/plugins/zsh-autosuggestions" ] || git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions "$custom_dir/plugins/zsh-autosuggestions"
}

setup_gitconfig
install_packages
setup_login_shell
setup_oh_my_zsh
setup_vim
install_dotfiles

# bin/dot knows what a dependency is on each platform
info "installing dependencies"
if source bin/dot | while read -r data; do info "$data"; done
then
  success "dependencies installed"
else
  fail "error installing dependencies"
fi

echo ''
echo '  All installed!'
